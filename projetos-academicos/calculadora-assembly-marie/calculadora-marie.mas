/ ==========================================
/ DADOS
/ ==========================================
Op,         DEC 0
N1,         DEC 0
N2,         DEC 0
RES,        DEC 0
TempTens,   DEC 0
TempUnits,  DEC 0
Counter,    DEC 0
DivTemp,    DEC 0

C0,         DEC 0
C1,         DEC 1
C2,         DEC 2
C3,         DEC 3
C4,         DEC 4
C5,         DEC 5
C6,         DEC 6
C7,         DEC 7
C8,         DEC 8
C9,         DEC 9
C10,        DEC 10
C100,       DEC 100

Cor,        HEX 0FFF
CorErro,    HEX F000

T21,        HEX 0F21
T22,        HEX 0F22
T23,        HEX 0F23
T31,        HEX 0F31
T32,        HEX 0F32
T33,        HEX 0F33
T41,        HEX 0F41
T42,        HEX 0F42
T43,        HEX 0F43
