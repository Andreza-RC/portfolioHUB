T52,        HEX 0F52
T53,        HEX 0F53
T61,        HEX 0F61
T62,        HEX 0F62
T63,        HEX 0F63

U25,        HEX 0F25
U26,        HEX 0F26
U27,        HEX 0F27
U35,        HEX 0F35
U36,        HEX 0F36
U37,        HEX 0F37
U45,        HEX 0F45
U46,        HEX 0F46
U47,        HEX 0F47
U55,        HEX 0F55
